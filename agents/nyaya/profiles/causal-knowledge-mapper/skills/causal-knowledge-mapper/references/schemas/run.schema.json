{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Causal knowledge-mapping run metadata",
  "type": "object",
  "required": ["run_id", "question", "scope", "input_source_ids", "schema_version", "method_version"],
  "properties": {
    "run_id": {"type": "string"},
    "question": {"type": "string"},
    "scope": {"type": "string"},
    "input_source_ids": {"type": "array", "items": {"type": "string"}},
    "input_fingerprints": {"type": "object", "additionalProperties": {"type": "string"}},
    "schema_version": {"const": "1.0"},
    "method_version": {"type": "string"},
    "execution_mode": {"enum": ["document_only", "document_and_data"]},
    "created_at": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}