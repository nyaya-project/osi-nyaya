{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osi-nyaya.local/schemas/materials-simulation-decision-lock.schema.json",
  "title": "Pre-simulation decision lock for materials hypothesis tests",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "experiment_plan_ref", "status", "structure_inputs", "simulation_protocol", "predictions", "outcome_rules", "locked_at"],
  "properties": {
    "schema_version": {"const": "materials-simulation-decision-lock/v1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "experiment_plan_ref": {"type": "string", "minLength": 1},
    "status": {"const": "locked_before_simulation"},
    "structure_inputs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["input_id", "provenance", "representation", "sha256"], "properties": {"input_id": {"type": "string"}, "provenance": {"type": "string"}, "representation": {"enum": ["allowed_identifier", "nonlicensed_generated_structure", "user_provided_structure"]}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "simulation_protocol": {"type": "object", "additionalProperties": false, "required": ["engine", "model_or_checkpoint", "relaxation", "observables"], "properties": {"engine": {"type": "string"}, "model_or_checkpoint": {"type": "string"}, "relaxation": {"type": "string"}, "observables": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "predictions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "outcome_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "locked_at": {"type": "string", "format": "date-time"}
  }
}
